# ==========================================
# LolAnalyzer Backend - Variables de Entorno
# ==========================================

# Base de Datos PostgreSQL Cloud (Supabase, Neon, AWS RDS, Render, etc.)
# Ejemplo: postgresql+asyncpg://usuario:password@host.supabase.co:5432/postgres
DATABASE_URL=

# Seguridad y Autenticación JWT
SECRET_KEY=tu_clave_secreta_jwt_para_firmar_tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 (Obtenlo en Google Cloud Console)
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Google Gemini API Key (Obtenla en Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Configuración del Servidor FastAPI
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Orígenes CORS permitidos (separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,overwolf-extension://*

# Configuración de Riot LCU (League Client Update)
LCU_POLL_INTERVAL=2.0
LCU_AUTO_CONNECT=True

# Configuración del Motor Heurístico (Ventanas Deslizantes)
SLIDING_WINDOW_SECONDS=180
TILT_DEATH_THRESHOLD=2
CS_CRASH_THRESHOLD=4.0
COOLDOWN_BETWEEN_ADVICE_SECONDS=30