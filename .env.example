# ==============================================================================
# LolAnalyzer Backend - Variables de Entorno (Supabase / Cloud PostgreSQL)
# ==============================================================================

# Supabase Connection URL
# Para Supabase, copia el URI desde: Project Settings -> Database -> Connection string -> URI (Direct o Transaction Pooler)
# Formato Directo: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Formato Pooler:  postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Seguridad y Autenticación JWT
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 (Google Cloud Console Client ID)
GOOGLE_CLIENT_ID=

# Google Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# Configuración del Servidor FastAPI
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Orígenes CORS permitidos (separados por comas)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,overwolf-extension://*

# Clave de desarrollo de Riot (developer.riotgames.com). Solo en el servidor.
# Riot Sign On requiere una aplicación de producción aprobada y no se usa en local.
RIOT_API_KEY=

# Configuración de Riot LCU (League Client Update)
LCU_POLL_INTERVAL=2.0
LCU_AUTO_CONNECT=True
LCU_TIMEOUT=5.0

# Motor Heurístico y Umbrales Tácticos de IA
SLIDING_WINDOW_SECONDS=180
TILT_DEATH_THRESHOLD=2
CS_CRASH_THRESHOLD=4.0
COOLDOWN_BETWEEN_ADVICE_SECONDS=30